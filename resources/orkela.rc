#include <winver.h>
#include "resource.h"

IDI_ORKELA ICON "orkela.ico"
IDR_ORKELA_MARK RCDATA "orkela-mark.png"
1 RT_MANIFEST "orkela.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,2
 PRODUCTVERSION 0,2,0,2
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x2L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SceneLith Project\0"
            VALUE "FileDescription", "Orkela media player\0"
            VALUE "FileVersion", "0.2.0-alpha.2\0"
            VALUE "InternalName", "Orkela\0"
            VALUE "OriginalFilename", "Orkela.exe\0"
            VALUE "ProductName", "Orkela\0"
            VALUE "ProductVersion", "0.2.0-alpha.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
