#include <windows.h>
#include "resource.h"

IDI_ORKELA ICON "orkela.ico"
IDR_ORKELA_MARK RCDATA "orkela-mark.png"
1 RT_MANIFEST "orkela.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,2
 PRODUCTVERSION 0,2,0,2
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SceneLith Project"
            VALUE "FileDescription", "Orkela media player"
            VALUE "FileVersion", "0.2.0-alpha.2"
            VALUE "InternalName", "Orkela"
            VALUE "OriginalFilename", "Orkela.exe"
            VALUE "ProductName", "Orkela"
            VALUE "ProductVersion", "0.2.0-alpha.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
